# Supabase project settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ZeroBounce dashboard -> API Settings (https://www.zerobounce.net/members/apikeys/)
# Server-side only — never prefix this with NEXT_PUBLIC_, it must not reach the browser.
ZEROBOUNCE_API_KEY=

# Supabase project settings -> API -> "service_role" secret key.
# EXTREMELY sensitive: bypasses every Row Level Security policy in the
# database. Used ONLY by src/utils/supabase/admin.ts, which is only ever
# imported by the cron quota-reset route. Never expose this to the
# browser, never reuse it anywhere else.
SUPABASE_SERVICE_ROLE_KEY=

# Any long random string you generate yourself (e.g. `openssl rand -hex 32`).
# Protects /api/cron/reset-quotas from being called by anyone else. Vercel
# automatically sends this as a Bearer token when it invokes the cron job,
# once the same value is set in your Vercel project's env vars.
CRON_SECRET=

# AWS IAM user credentials with ses:SendEmail permission (SES console ->
# your region -> or IAM -> Users -> create one scoped to SES only).
# Server-side only — never prefix with NEXT_PUBLIC_.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# The AWS region your SES identity is verified in, e.g. us-east-1
AWS_REGION=

# The verified SES sender address campaigns are sent from, e.g.
# campaigns@flashfastai.com. Must be a verified identity (or belong to a
# verified domain) in the SES account above, in the same region.
SES_FROM_ADDRESS=
